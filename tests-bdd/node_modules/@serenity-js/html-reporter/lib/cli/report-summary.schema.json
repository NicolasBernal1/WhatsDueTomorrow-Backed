{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "JSON Schema URL for self-documentation",
      "type": "string"
    },
    "generated": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "ISO 8601 timestamp when this summary was generated"
    },
    "title": {
      "type": "string",
      "description": "Report title (from config or auto-detected)"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Schema version for forward compatibility"
    },
    "reportUrl": {
      "description": "URL to the full HTML report (relative or absolute)",
      "type": "string"
    },
    "ci": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "description": "Git commit SHA"
        },
        "branch": {
          "type": "string",
          "description": "Git branch name"
        },
        "jobUrl": {
          "description": "URL to the CI job (e.g. GitHub Actions run)",
          "type": "string"
        },
        "pullRequestUrl": {
          "description": "URL to the associated pull request",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "branch"
      ],
      "additionalProperties": false,
      "description": "CI/CD context for the latest run"
    },
    "latestRun": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "ISO 8601 timestamp when the run started"
        },
        "label": {
          "type": "string",
          "description": "Human-readable run label (e.g. \"#8300\", \"17 Jul 2026 14:50\")"
        },
        "totals": {
          "type": "object",
          "properties": {
            "passed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "pending": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "skipped": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "compromised": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "error": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "passed",
            "failed",
            "pending",
            "skipped",
            "compromised",
            "error"
          ],
          "additionalProperties": false,
          "description": "Outcome counts for the test run"
        },
        "duration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Total execution duration in milliseconds"
        }
      },
      "required": [
        "timestamp",
        "label",
        "totals",
        "duration"
      ],
      "additionalProperties": false,
      "description": "Summary of a single test run"
    },
    "runs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Total number of historical test runs in the report"
    },
    "delta": {
      "description": "Outcome count changes vs the previous run. Absent when only one run exists.",
      "type": "object",
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Change in passed count vs previous run (positive = improvement)"
        },
        "failed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Change in failed count vs previous run (positive = more failures)"
        },
        "pending": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Change in pending count"
        },
        "skipped": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Change in skipped count"
        },
        "compromised": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Change in compromised count"
        },
        "error": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Change in error count"
        }
      },
      "required": [
        "passed",
        "failed",
        "pending",
        "skipped",
        "compromised",
        "error"
      ],
      "additionalProperties": false
    },
    "failureClusters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fingerprint": {
            "type": "string",
            "description": "Stable identifier for this error group (normalised from error type + message)"
          },
          "errorType": {
            "type": "string",
            "description": "Error class/type name (e.g. \"AssertionError\", \"TimeoutError\")"
          },
          "message": {
            "type": "string",
            "description": "Normalised error message (ANSI stripped, absolute paths stripped, truncated to 200 chars)"
          },
          "scenarios": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Scenario name"
                },
                "source": {
                  "type": "string",
                  "description": "Source location as relative path:line (e.g. \"spec/login.spec.ts:42\")"
                },
                "browser": {
                  "description": "Browser/project identifier (e.g. \"chromium 149.0.7827.55\")",
                  "type": "string"
                },
                "failingStep": {
                  "description": "Name of the deepest failing activity in the activity tree",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "source"
              ],
              "additionalProperties": false,
              "description": "A scenario within a failure cluster"
            }
          }
        },
        "required": [
          "fingerprint",
          "errorType",
          "message",
          "scenarios"
        ],
        "additionalProperties": false,
        "description": "A group of scenarios sharing the same error fingerprint"
      },
      "description": "Failures grouped by error fingerprint. Empty array when all tests pass."
    },
    "consistency": {
      "type": "object",
      "properties": {
        "flaky": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Scenario name"
              },
              "source": {
                "type": "string",
                "description": "Source location as relative path:line"
              },
              "browser": {
                "description": "Browser/project identifier",
                "type": "string"
              },
              "lastOutcome": {
                "description": "Most recent outcome for this test (e.g. \"SUCCESS\", \"FAILURE\", \"RETRIED_SUCCESS\")",
                "type": "string"
              }
            },
            "required": [
              "name",
              "source"
            ],
            "additionalProperties": false,
            "description": "A scenario with a consistency classification"
          },
          "description": "Tests that pass only via retry (build green, test unreliable)"
        },
        "inconsistent": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Scenario name"
              },
              "source": {
                "type": "string",
                "description": "Source location as relative path:line"
              },
              "browser": {
                "description": "Browser/project identifier",
                "type": "string"
              },
              "lastOutcome": {
                "description": "Most recent outcome for this test (e.g. \"SUCCESS\", \"FAILURE\", \"RETRIED_SUCCESS\")",
                "type": "string"
              }
            },
            "required": [
              "name",
              "source"
            ],
            "additionalProperties": false,
            "description": "A scenario with a consistency classification"
          },
          "description": "Tests whose final outcome differs across runs"
        },
        "degraded": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Scenario name"
              },
              "source": {
                "type": "string",
                "description": "Source location as relative path:line"
              },
              "browser": {
                "description": "Browser/project identifier",
                "type": "string"
              },
              "lastOutcome": {
                "description": "Most recent outcome for this test (e.g. \"SUCCESS\", \"FAILURE\", \"RETRIED_SUCCESS\")",
                "type": "string"
              }
            },
            "required": [
              "name",
              "source"
            ],
            "additionalProperties": false,
            "description": "A scenario with a consistency classification"
          },
          "description": "Tests that were passing, now failing"
        },
        "recovered": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Scenario name"
              },
              "source": {
                "type": "string",
                "description": "Source location as relative path:line"
              },
              "browser": {
                "description": "Browser/project identifier",
                "type": "string"
              },
              "lastOutcome": {
                "description": "Most recent outcome for this test (e.g. \"SUCCESS\", \"FAILURE\", \"RETRIED_SUCCESS\")",
                "type": "string"
              }
            },
            "required": [
              "name",
              "source"
            ],
            "additionalProperties": false,
            "description": "A scenario with a consistency classification"
          },
          "description": "Tests that were failing, now pass cleanly"
        }
      },
      "required": [
        "flaky",
        "inconsistent",
        "degraded",
        "recovered"
      ],
      "additionalProperties": false,
      "description": "Cross-run consistency classifications with affected test references"
    },
    "scores": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Composite confidence score: passRate × 0.40 + completeness × 0.25 + consistency × 0.35"
        },
        "passRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of executed scenarios passing"
        },
        "completeness": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of scenarios that are implemented (not pending/skipped)"
        },
        "consistency": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Outcome repeatability across runs"
        }
      },
      "required": [
        "confidence",
        "passRate",
        "completeness",
        "consistency"
      ],
      "additionalProperties": false,
      "description": "Composite quality scores (0–100)"
    },
    "slowest": {
      "description": "Top 5 slowest scenarios in the latest run by duration",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Scenario name"
          },
          "source": {
            "type": "string",
            "description": "Source location as relative path:line"
          },
          "duration": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Execution duration in milliseconds"
          }
        },
        "required": [
          "name",
          "source",
          "duration"
        ],
        "additionalProperties": false,
        "description": "A scenario identified as one of the slowest in the run"
      }
    },
    "modules": {
      "description": "Per-module breakdown of the latest run. Present when the run was aggregated from multiple modules.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Module identifier (e.g. \"@integration/playwright-web\")"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "incomplete"
            ],
            "description": "Overall module outcome"
          },
          "tests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Number of test scenarios in this module"
          },
          "passed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Number of passing scenarios"
          },
          "failed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Number of failing scenarios (failed + error + compromised)"
          },
          "duration": {
            "description": "Module execution duration in milliseconds",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "startedAt": {
            "type": "string",
            "description": "ISO 8601 timestamp when the module started"
          },
          "finishedAt": {
            "description": "ISO 8601 timestamp when the module finished (absent for incomplete modules)",
            "type": "string"
          }
        },
        "required": [
          "id",
          "outcome",
          "tests",
          "passed",
          "failed",
          "startedAt"
        ],
        "additionalProperties": false,
        "description": "Per-module outcome summary"
      }
    }
  },
  "required": [
    "generated",
    "title",
    "schemaVersion",
    "latestRun",
    "runs",
    "failureClusters",
    "consistency",
    "scores"
  ],
  "additionalProperties": false,
  "description": "Machine-readable summary of an aggregated Serenity/JS HTML test report. Designed for AI agents, CI bots, and custom tooling.",
  "$id": "https://serenity-js.org/schemas/report-summary.json",
  "title": "Serenity/JS Report Summary"
}
