{
  "name": "whats-due-tomorrow-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=regression",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:regression": "jest regression",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:cy:f21": "cypress run --spec \"cypress/e2e/f21-urgent-radar/**/*.cy.js\"",
    "test:cy:f22": "cypress run --spec \"cypress/e2e/f22-subtasks/**/*.cy.js\"",
    "test:cy:f23": "cypress run --spec \"cypress/e2e/f23-calendar/**/*.cy.js\"",
    "test:cy:f24": "cypress run --spec \"cypress/e2e/f24-notes/**/*.cy.js\"",
    "test:cy:f25": "cypress run --spec \"cypress/e2e/f25-evaluations/**/*.cy.js\"",
    "test:cy:f26": "cypress run --spec \"cypress/e2e/f26-academic-load/**/*.cy.js\"",
    "test:bdd": "npm --prefix tests-bdd run test",
    "test:bdd:f21": "npm --prefix tests-bdd run test:bdd:f21",
    "test:bdd:f22": "npm --prefix tests-bdd run test:bdd:f22",
    "test:bdd:f23": "npm --prefix tests-bdd run test:bdd:f23",
    "test:bdd:f24": "npm --prefix tests-bdd run test:bdd:f24",
    "test:bdd:f25": "npm --prefix tests-bdd run test:bdd:f25",
    "test:bdd:f26": "npm --prefix tests-bdd run test:bdd:f26",
    "test:bdd:all": "npm --prefix tests-bdd run test:bdd:all",
    "test:cy:nicolas": "cypress run --config-file cypress.nicolas.config.js",
    "test:cy:nicolas:api": "cypress run --config-file cypress.nicolas.config.js --spec \"cypress_nicolas/e2e/api/**/*.cy.js\"",
    "test:cy:nicolas:regression": "cypress run --config-file cypress.nicolas.config.js --spec \"cypress_nicolas/e2e/regression/**/*.cy.js\"",
    "test:cy:nicolas:security": "cypress run --config-file cypress.nicolas.config.js --spec \"cypress_nicolas/e2e/security/**/*.cy.js\"",
    "test:cy:nicolas:perf": "cypress run --config-file cypress.nicolas.config.js --spec \"cypress_nicolas/e2e/performance/**/*.cy.js\"",
    "cypress:nicolas:open": "cypress open --config-file cypress.nicolas.config.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.7",
    "@nestjs/typeorm": "^11.0.0",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "mysql2": "^3.15.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^7.1.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "cypress": "^16.2.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.4.1",
    "mochawesome": "^8.1.1",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}